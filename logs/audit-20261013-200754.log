   220          "repetition", "elapsed_ns", "correct",
   221      ]
   222      with open(csv_path, "w", newline="") as f:
   223          writer = csv.DictWriter(f, fieldnames=fieldnames)
   224          writer.writeheader()
   225          writer.writerows(results)
