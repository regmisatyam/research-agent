   241          summary[key].append(r["elapsed_ns"])
   242  
   243      for key in sorted(summary.keys()):
   244          algo, size, itype = key
   245          vals = summary[key]
   246          mean_val = statistics.mean(vals)
   247          std_val = statistics.stdev(vals) if len(vals) > 1 else 0
   248          print(f"  {algo:20s}  size={size:5d}  {itype:15s}  mean={mean_val:>12.0f} ns  std={std_val:>10.0f} ns")
   249  
