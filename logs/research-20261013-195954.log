a[j]\n            j -= 1\n        a[j + 1] = key\n    return a\n\n\ndef merge_sort(arr):\n    \"\"\"Top-down merge sort.
Returns a new sorted list.\"\"\"\n    a = list(arr)  # work on a copy\n    if len(a) <= 1:\n        return a\n    mid = 
len(a) // 2\n    left = merge_sort(a[:mid])\n    right = merge_sort(a[mid:])\n    return _merge(left, right)\n\n\ndef 
_merge(left, right):\n    \"\"\"Merge two sorted lists into one sorted list.\"\"\"\n    result = []\n    i = j = 0\n    
